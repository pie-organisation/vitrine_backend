DATABASE_URL=postgresql://user:password@localhost:5432/cubi
JWT_SECRET=change_me_in_production
JWT_EXPIRATION_HOURS=24
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxx
SMTP_FROM=noreply@tondomain.com
APP_ENV=development
APP_PORT=3000

# E-mails transactionnels : le code passe par l'API Brevo (BREVO_API_KEY + SMTP_FROM comme expéditeur)
BREVO_API_KEY=
# 'memoire' en test : aucun e-mail envoyé, ils restent en mémoire (src/email.js)
EMAIL_TRANSPORT=brevo

# URL du front, sans slash final : liens des e-mails (signature, invitations) et seule origine CORS de /signature
FRONT_URL=http://localhost:5173

# Secret du cron externe : header X-Job-Secret de POST /internal/jobs/quotidien. Vide = endpoint désactivé (503)
JOB_SECRET=

# Frais de mise en service HT (en centimes) ajoutés à la première facture d'un contrat. 0 = aucune ligne
FRAIS_MISE_EN_SERVICE_CENTIMES=0

# Mentions légales de Cubi (factures et contrats PDF, cf. src/pdf/emetteur.js)
CUBI_RAISON_SOCIALE=À COMPLÉTER
CUBI_FORME_JURIDIQUE=À COMPLÉTER
CUBI_CAPITAL=À COMPLÉTER
CUBI_ADRESSE=À COMPLÉTER
CUBI_SIRET=À COMPLÉTER
CUBI_RCS=À COMPLÉTER
CUBI_TVA_INTRACOM=À COMPLÉTER
CUBI_EMAIL_FACTURATION=À COMPLÉTER
CUBI_IBAN=À COMPLÉTER
CUBI_BIC=À COMPLÉTER
CUBI_DELAI_PAIEMENT_JOURS=30
CUBI_SIGNATAIRE_NOM=À COMPLÉTER
CUBI_SIGNATAIRE_FONCTION=À COMPLÉTER
# Optionnel : signature PNG de Cubi en base64. Absente = « En attente de contre-signature » sur le contrat
CUBI_SIGNATURE_PNG_BASE64=

# Tests sur base (test/*-integration.test.js, test/migration-004.test.js) : base de test dédiée uniquement, jamais la base partagée. Vide = tests ignorés
TEST_DATABASE_URL=
